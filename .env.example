# Copy to .env and adjust. Used by server (Node) and optional Vite prefix VITE_*.

# MongoDB — local (Compass / mongod)
MONGODB_URI=mongodb://localhost:27017

# Atlas: Network Access → allow your IP (or 0.0.0.0/0 only for testing). Use Database user + password.
# Put the database name before "?" (e.g. /attendance) or rely on MONGODB_DB below.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/attendance?retryWrites=true&w=majority&appName=YourApp

MONGODB_DB=attendance
MONGODB_COLLECTION=attendance managment

# If 3002 is taken, pick another free port and keep Vite proxy in sync (vite.config reads API_PORT)
API_PORT=3002

# Production: set to your deployed frontend origin, e.g. https://myapp.vercel.app
# CORS_ORIGIN=http://localhost:5173
